# Copy this file to .env and fill in your own values. .env is never committed.

# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Shared-secret gate for audit-trail endpoints (swap for real SSO later)
OFFICER_ACCESS_CODE=officer2026

# Where the Streamlit frontend is served from, for CORS
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Optional overrides — defaults are fine for local dev
# DB_PATH=./audit_trail.db
# MOCK_PORTAL_PATH=./mock_portal_data.json
